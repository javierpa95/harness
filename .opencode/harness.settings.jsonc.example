{
  // harness.settings.jsonc example - Single Source of Truth for the harness setup.
  //
  // This file centralizes agent configuration. `make setup` applies it to the
  // .opencode/agents/*.md files (writes `model:` and `mode:` in frontmatter).
  //
  // If this file does NOT exist under the name `harness.settings.jsonc`,
  // `make setup` runs the interactive TUI and generates it. Copy this `.example`
  // to `harness.settings.jsonc` and adjust, or run `make setup` and let it generate.
  //
  // "model" format: "provider/model-id" (run `opencode models` to list them).
  // "mode" format: "primary" | "subagent" | "all" (omit to leave the agent's mode)
  // The values below are illustrative defaults - adjust them to your stack.

  "default_model": "nan/deepseek-v4-flash",

  "agents": {
    "spec-writer":          { "model": "nan/deepseek-v4-flash", "mode": "subagent" },
    "frontend-developer":   { "model": "nan/deepseek-v4-flash" },
    "backend-developer":    { "model": "nan/deepseek-v4-flash" },
    "code-reviewer":        { "model": "nan/deepseek-v4-flash" },
    "gdpr-auditor":         { "model": "nan/deepseek-v4-flash" },
    "release-manager":      { "model": "nan/deepseek-v4-flash" },
    "design":               { "model": "nan/deepseek-v4-flash", "mode": "all" }
  }
}