# =============================================================================
# CI Advanced — Full Pipeline
# =============================================================================
# Para activar: make ci-enable-advanced
# Para desconectar: make ci-disable
# =============================================================================

name: CI Advanced

on:
  push:
    branches: [main, master]
  pull_request:
    branches: [main, master]

jobs:
  # ── Basic (from ci-basic) ──
  lint:
    name: Lint
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npm run lint

  typecheck:
    name: Type Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npx tsc --noEmit

  test:
    name: Test
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - run: npm test

  commitlint:
    name: Commit Messages
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: npm ci
      - run: npx commitlint --from ${{ github.event.pull_request.base.sha }} --to ${{ github.event.pull_request.head.sha }} --verbose

  # ── Security ──
  security:
    name: Security Scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - name: Audit dependencies
        run: npm audit --audit-level=high || true
      - name: Check for secrets
        run: |
          if grep -rE "(password|secret|token|api_key)\s*[:=]\s*['\"]" --include="*.ts" --include="*.js" --include="*.py" .; then
            echo "❌ Potential secrets found!"
            exit 1
          fi

  # ── Coverage ──
  coverage:
    name: Test Coverage
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
          cache: 'npm'
      - run: npm ci
      - name: Run tests with coverage
        run: npm test -- --coverage || npm test
      - name: Check coverage threshold
        run: |
          if [ -f "coverage/coverage-summary.json" ]; then
            COVERAGE=$(cat coverage/coverage-summary.json | jq '.total.lines.pct')
            echo "Coverage: $COVERAGE%"
            if (( $(echo "$COVERAGE < 80" | bc -l) )); then
              echo "❌ Coverage below 80% threshold"
              exit 1
            fi
          fi

  # ── Docker Build ──
  docker:
    name: Docker Build
    runs-on: ubuntu-latest
    if: github.event_name == 'push'
    steps:
      - uses: actions/checkout@v4
      - name: Build Docker image
        run: docker compose build 2>/dev/null || echo "No docker-compose.yml found, skipping"
      - name: Verify image
        run: docker images | grep -q "${{ github.repository }}" || echo "No image to verify"

  # ── Docs Check ──
  docs:
    name: Docs Check
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Check CHANGELOG updated
        run: |
          if git diff --name-only HEAD~1 | grep -q "\.ts$\|\.tsx$\|\.js$\|\.jsx$\|\.py$"; then
            if ! git diff --name-only HEAD~1 | grep -q "CHANGELOG"; then
              echo "⚠️ Code changed but CHANGELOG not updated"
            fi
          fi
      - name: Check for broken links
        run: |
          grep -roh 'https://[^ ]*' docs/ 2>/dev/null | while read url; do
            curl -s -o /dev/null -w "%{http_code}" "$url" | grep -q "404" && echo "Broken link: $url"
          done || true
