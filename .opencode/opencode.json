{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env*": "deny",
      "node_modules/**/*": "deny",
      "dist/**/*": "deny",
      "**/pb_data/**/*": "deny",
      "**/*.db": "deny"
    },
    "glob": {
      "node_modules/*": "deny",
      "dist/*": "deny",
      "**/pb_data/*": "deny"
    },
    "edit": {
      ".opencode/**/*": "deny",
      ".env*": "deny",
      "**/pb_data/**/*": "deny",
      "**/*.db": "deny"
    },
    "bash": "ask"
  },
  "default_agent": "project-architect"
}
