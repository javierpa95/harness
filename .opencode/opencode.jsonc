{
  // Un solo fichero de config (antes había opencode.json + opencode.jsonc,
  // duplicados byte a byte — con jsonc alcanza, admite comentarios).
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      ".env*": "deny",
      "node_modules/**/*": "deny",
      "dist/**/*": "deny",
      "**/pb_data/**/*": "deny",
      "**/*.db": "deny"
    },
    "glob": {
      "node_modules/*": "deny",
      "dist/*": "deny",
      "**/pb_data/*": "deny"
    },
    // Red de seguridad por defecto para cualquier agente que no declare su
    // propio permiso `edit`. Los agentes SÍ lo declaran (ver .opencode/agents/*.md)
    // y ese permiso por-agente manda sobre este: project-architect y
    // harness-arquitect tienen `edit: allow` sin restricciones y pueden tocar
    // (lo necesita en el Paso 4 del onboarding, aunque lo normal es que
    // ./init.sh ya lo haya hecho antes de la primera sesión).
    "edit": {
      ".opencode/**/*": "deny",
      ".env*": "deny",
      "**/pb_data/**/*": "deny",
      "**/*.db": "deny"
    },
    "bash": "ask"
  },
  // ============================================================
  // MCP Servers
  // ============================================================
  // Deshabilitados por defecto: cada MCP anade tokens al contexto
  // del LLM. Activar solo los que necesites por proyecto.
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@gentlest-mcp/codegraph"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "engram": {
      "type": "local",
      "command": ["npx", "-y", "@gentlest-mcp/engram"],
      "enabled": false
    }
  },
  // Deshabilitar todas las tools de MCP por defecto.
  // Se activan por-agente cuando el architect decide que son necesarias.
  "tools": {
    "codegraph_*": false,
    "context7_*": false,
    "engram_*": false
  },
  "default_agent": "project-architect"
}
