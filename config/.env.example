# [PROJECT_NAME] - Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env files to the repository.

# ==========================================
# Backend / Database
# ==========================================
# URL of your backend service (local or production)
BACKEND_URL=http://localhost:8090

# Database connection string (if applicable)
# DATABASE_URL=

# Admin/service credentials
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD=your-secure-password-here

# ==========================================
# Auth / Secrets
# ==========================================
# Secret key for session/auth (generate a random string)
# AUTH_SECRET=

# ==========================================
# Frontend
# ==========================================
# Site URL for production
SITE_URL=https://your-domain.com

# Node environment
NODE_ENV=development

# ==========================================
# Add your project-specific variables below
# ==========================================
